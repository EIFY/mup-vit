# TEMPLATE ONLY. Do not put your keys in this file: it is committed to git.
#
# Put them in a file named .env next to this one (git ignores .env, so it is never pushed):
#   cp .env.example .env && chmod 600 .env    # setup_machine.sh does this if .env is missing
#   nano .env                                 # fill in the three empty values below
# Format: KEY=value on one line, no quotes, no spaces around '='.
# .env is not in the git repo, so every new machine needs its own copy: create it as above, or
# copy yours over with  scp .env <user>@<host>:<path>/ViT-perforated/.env

# Weights & Biases: API key from https://wandb.ai/authorize (it identifies your W&B user).
# WANDB_ENTITY is the team the runs are logged under; WANDB_PROJECT the project in that team.
WANDB_API_TOKEN=
WANDB_ENTITY=IdlF26Group40
WANDB_PROJECT=ViT-perforated

# PerforatedAI license (perforatedbp checks it when it builds dendrites).
PAIEMAIL=
PAITOKEN=
